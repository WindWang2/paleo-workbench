<?xml version="1.0"?>
<typesystem package="welllog._QtWidgets">
    <load-typesystem name="typesystem_widgets.xml" generate="no"/>
    <load-typesystem name="typesystem_openglwidgets.xml" generate="no"/>
    <load-typesystem name="typesystem_core.xml" generate="no"/>

    <namespace-type name="welllog">
        <object-type name="WellLogView" parent-management="yes">
            <extra-includes>
                <include file-name="numpy_bridge.hpp" location="local"/>
            </extra-includes>
            <add-function
                signature="submit_curve(PyObject*@depth@,PyObject*@values@,QString@document_id@,QString@axis_id@,QString@curve_id@,QString@mnemonic@,QString@depth_unit@,QString@value_unit@)"
                return-type="PyObject*"
            >
                <inject-code class="target" position="beginning">
                    %PYARG_0 = welllog::python::submit_curve(
                        %CPPSELF, %PYARG_1, %PYARG_2, %3, %4, %5, %6, %7, %8);
                </inject-code>
            </add-function>
            <add-function
                signature="sample_value(QString@curve_id@,unsigned long long@sample_index@)"
                return-type="PyObject*"
            >
                <inject-code class="target" position="beginning">
                    %PYARG_0 = welllog::python::sample_value(
                        %CPPSELF, %1, %2);
                </inject-code>
            </add-function>
        </object-type>

        <!-- Virtualized Table Projection model (ADR 0022, #154). The core
             TableProjection is bound as a value type so a Python host can pass
             one to TableModel.set_projection(); the host builds it from a
             session via a convenience bridge (the from_document factory needs
             a full WellLogDocument binding, a separate follow-up). -->
        <value-type name="TableProjection"/>
        <object-type name="TableModel" parent-management="yes"/>
    </namespace-type>
</typesystem>
